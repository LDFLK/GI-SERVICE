FROM redis:7-alpine

# Choreo requires a numeric USER in 10000–20000 (not a username).
RUN adduser -D -H -u 10014 -s /sbin/nologin choreo \
    && mkdir -p /data \
    && chown -R 10014:10014 /data

USER 10014
WORKDIR /data
EXPOSE 6379

CMD ["redis-server", "--bind", "0.0.0.0", "--port", "6379", "--maxmemory", "256mb", "--maxmemory-policy", "allkeys-lru"]
