BASE_URL_QUERY=BASE_URL_QUERY
# Comma-separated list of allowed origins for CORS (replace as needed)
ALLOWED_ORIGINS=http://localhost:3000

# HTTP Connection Pool Configuration (Optional)
# Adjust based on your deployment resources and backend capacity
HTTP_POOL_SIZE=50
HTTP_POOL_SIZE_PER_HOST=40
HTTP_TIMEOUT_TOTAL=90

# Timeout configs
HTTP_TIMEOUT_CONNECT=30
HTTP_TIMEOUT_SOCK_CONNECT=30
HTTP_TIMEOUT_SOCK_READ=90
HTTP_TTL_DNS_CACHE=300

# Cache (Redis). Leave CACHE_ENABLED=false for local/tests without Redis.
# Docker without cache: make up (uses these values).
# Docker with cache: make up-cache (compose sets REDIS_URL + CACHE_ENABLED=true).
CACHE_ENABLED=false
REDIS_URL=redis://localhost:6379/0

# Optional Redis configuration
REDIS_MAX_CONNECTIONS=200
REDIS_POOL_TIMEOUT_SECONDS=5.0
CACHE_KEY_PREFIX=gi:v1
CACHE_TTL_SECONDS=604800
